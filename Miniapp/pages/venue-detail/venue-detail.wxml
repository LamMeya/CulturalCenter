<!-- pages/venue-detail/venue-detail.wxml — 场馆详情与预约 -->
<view class="page-venue-detail">

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载场馆信息...</text>
  </view>

  <block wx:if="{{!loading && venue}}">

    <!-- 场馆 Hero 区 -->
    <view class="venue-hero">
      <image
        wx:if="{{venue.image_url}}"
        src="{{venue.image_url}}"
        mode="aspectFill"
        class="hero-image"
      />
      <view wx:else class="hero-placeholder">
        <view class="hero-wave">
          <view class="hw-1"></view>
          <view class="hw-2"></view>
        </view>
        <text class="hero-icon">🏛</text>
      </view>
      <view class="hero-overlay">
        <view class="hero-tag" wx:if="{{venue.category}}">{{venue.category}}</view>
        <text class="hero-name">{{venue.name}}</text>
        <text class="hero-desc" wx:if="{{venue.description}}">{{venue.description}}</text>
      </view>
    </view>

    <!-- 场馆信息卡片 -->
    <view class="info-card">
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">容纳人数</text>
          <text class="info-value">{{venue.capacity || '--'}} 人</text>
        </view>
        <view class="info-item">
          <text class="info-label">场馆面积</text>
          <text class="info-value">{{venue.area || '--'}} m²</text>
        </view>
        <view class="info-item">
          <text class="info-label">开放状态</text>
          <text class="info-value">
            <text class="status-dot {{venue.status === 'open' ? 'dot-open' : 'dot-closed'}}"></text>
            {{venue.status === 'open' ? '开放中' : '维护中'}}
          </text>
        </view>
      </view>

      <view class="info-facilities" wx:if="{{venue.facilities && venue.facilities.length > 0}}">
        <text class="facility-label">配套设施</text>
        <view class="facility-list">
          <text class="f-tag" wx:for="{{venue.facilities}}" wx:key="*this" wx:for-item="f">{{f}}</text>
        </view>
      </view>

      <view class="info-address" wx:if="{{venue.address}}">
        <text class="address-icon">📍</text>
        <text class="address-text">{{venue.address}}</text>
      </view>
    </view>

    <!-- 步骤1：日期选择 -->
    <view class="booking-section">
      <view class="step-header">
        <view class="step-badge">1</view>
        <text class="step-title">选择日期</text>
      </view>

      <scroll-view class="date-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="date-strip-inner">
          <view
            class="date-item {{item.date === selectedDate ? 'date-active' : ''}} {{item.available === false ? 'date-disabled' : ''}}"
            wx:for="{{dateList}}"
            wx:key="date"
            data-date="{{item.date}}"
            bindtap="selectDate"
          >
            <text class="date-dayname">{{item.dayName}}</text>
            <text class="date-day">{{item.day}}</text>
            <text class="date-month">{{item.monthDay}}</text>
            <view class="date-dot" wx:if="{{item.available === true}}"></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 步骤2：时间段选择 -->
    <view class="booking-section">
      <view class="step-header">
        <view class="step-badge">2</view>
        <text class="step-title">选择时段</text>
        <text class="step-hint">已选 {{selectedSlots.length}}/{{maxSlots}}</text>
      </view>

      <!-- 加载中 -->
      <view class="slot-loading" wx:if="{{dateLoading}}">
        <view class="loading-spinner small"></view>
        <text>加载时段...</text>
      </view>

      <!-- 无可用时段 -->
      <view class="slot-empty" wx:if="{{!dateLoading && timeSlots.length === 0 && selectedDate}}">
        <text class="empty-icon">📅</text>
        <text class="empty-text">该日期暂无可用时段</text>
        <text class="empty-hint">请选择其他日期</text>
      </view>

      <block wx:if="{{!dateLoading && timeSlots.length > 0}}">
        <!-- 上午时段 -->
        <view class="slot-group" wx:if="{{morningSlots.length > 0}}">
          <view class="slot-group-header">
            <text class="group-icon">🌅</text>
            <text class="group-title">上午</text>
          </view>
          <view class="slot-grid">
            <view
              class="slot-item {{selectedSlotIds.indexOf(item.id) >= 0 ? 'slot-selected' : ''}}"
              wx:for="{{morningSlots}}"
              wx:key="id"
              data-slot="{{item}}"
              bindtap="onSlotTap"
            >
              <text class="slot-time">{{item.start_time}} - {{item.end_time}}</text>
              <text class="slot-duration" wx:if="{{item.duration}}">{{item.duration}}分钟</text>
              <view class="slot-check" wx:if="{{selectedSlotIds.indexOf(item.id) >= 0}}">✓</view>
            </view>
          </view>
        </view>

        <!-- 下午时段 -->
        <view class="slot-group" wx:if="{{afternoonSlots.length > 0}}">
          <view class="slot-group-header">
            <text class="group-icon">🌇</text>
            <text class="group-title">下午</text>
          </view>
          <view class="slot-grid">
            <view
              class="slot-item {{selectedSlotIds.indexOf(item.id) >= 0 ? 'slot-selected' : ''}}"
              wx:for="{{afternoonSlots}}"
              wx:key="id"
              data-slot="{{item}}"
              bindtap="onSlotTap"
            >
              <text class="slot-time">{{item.start_time}} - {{item.end_time}}</text>
              <text class="slot-duration" wx:if="{{item.duration}}">{{item.duration}}分钟</text>
              <view class="slot-check" wx:if="{{selectedSlotIds.indexOf(item.id) >= 0}}">✓</view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部占位（避免被固定栏遮挡） -->
    <view class="bottom-spacer"></view>
  </block>

  <!-- 底部固定栏 -->
  <view class="bottom-bar" wx:if="{{!loading && venue}}">
    <view class="bottom-left">
      <text class="bottom-count">已选 <text class="count-num">{{selectedSlots.length}}</text>/{{maxSlots}} 个时段</text>
      <view class="selected-summary" wx:if="{{selectedSlots.length > 0}}">
        <text class="summary-item" wx:for="{{selectedSlots}}" wx:key="id" wx:for-item="s">
          {{s.start_time}}-{{s.end_time}}
        </text>
      </view>
    </view>
    <view
      class="btn-confirm {{selectedSlots.length === 0 ? 'btn-disabled' : ''}}"
      bindtap="onConfirmBooking"
    >
      确认预约
    </view>
  </view>

  <!-- 确认弹窗 -->
  <view class="modal-mask" wx:if="{{showConfirmModal}}" bindtap="onCloseConfirmModal">
    <view class="modal-content" catchtap>
      <text class="modal-title">确认预约信息</text>

      <view class="modal-info">
        <view class="modal-row">
          <text class="modal-label">场馆</text>
          <text class="modal-value">{{venue.name}}</text>
        </view>
        <view class="modal-row">
          <text class="modal-label">日期</text>
          <text class="modal-value">{{selectedDate}}</text>
        </view>
        <view class="modal-row">
          <text class="modal-label">时段</text>
          <view class="modal-value">
            <text class="modal-slot" wx:for="{{selectedSlots}}" wx:key="id" wx:for-item="s">
              {{s.start_time}} - {{s.end_time}}
            </text>
          </view>
        </view>
        <view class="modal-row">
          <text class="modal-label">团队</text>
          <text class="modal-value">{{userTeam.name || '--'}}</text>
        </view>
      </view>

      <view class="modal-actions">
        <view class="btn-cancel" bindtap="onCloseConfirmModal">取消</view>
        <view class="btn-submit {{submitting ? 'btn-loading' : ''}}" bindtap="onSubmitBooking">
          {{submitting ? '提交中...' : '确认提交'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 成功弹窗 -->
  <view class="modal-mask" wx:if="{{showSuccessModal}}">
    <view class="modal-content success-modal">
      <view class="success-icon">✓</view>
      <text class="success-title">预约成功！</text>
      <text class="success-desc">您的场馆预约已提交，请等待审核</text>

      <view class="success-info" wx:if="{{bookingResult}}">
        <view class="si-row">
          <text class="si-label">预约编号</text>
          <text class="si-value">{{bookingResult.id || bookingResult.booking_id}}</text>
        </view>
        <view class="si-row" wx:if="{{bookingResult.status}}">
          <text class="si-label">状态</text>
          <text class="si-value status-pending">待审核</text>
        </view>
      </view>

      <view class="success-actions">
        <view class="btn-back" bindtap="onCloseSuccessModal">返回</view>
        <view class="btn-view-bookings" bindtap="onViewBookings">查看我的预约</view>
      </view>
    </view>
  </view>
</view>