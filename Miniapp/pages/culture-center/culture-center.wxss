/* pages/culture-center/culture-center.wxss — 文化中心介绍 */

.page-container {
  min-height: 100vh;
  background: var(--dm-bg);
}

/* ========== Hero 区域 ========== */
.hero-section {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.hero-svg {
  width: 100%;
  height: 100%;
}

.hero-svg svg {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.08);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3d8e7a;
  margin-bottom: 12rpx;
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.6);
}

.hero-subtitle {
  font-size: 28rpx;
  color: #5a9e8e;
  letter-spacing: 8rpx;
}

/* ========== 内容区块 ========== */
.content-section {
  margin-top: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
}

.section-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--dm-primary);
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--dm-text);
}

.section-text {
  font-size: 28rpx;
  color: var(--dm-text);
  line-height: 1.8;
  display: block;
  margin-bottom: 16rpx;
}

.section-text:last-child {
  margin-bottom: 0;
}

/* ========== 场地设施 ========== */
.facility-list {
  display: flex;
  flex-direction: column;
}

.facility-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: var(--dm-text);
  border-bottom: 1rpx solid var(--dm-border);
}

.facility-item:last-child {
  border-bottom: none;
}

.facility-dot {
  color: var(--dm-primary);
  margin-right: 12rpx;
  font-weight: 700;
}

/* ========== 预约规则 ========== */
.rules-card {
  padding: 24rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--dm-border);
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--dm-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.rule-text {
  font-size: 26rpx;
  color: var(--dm-text);
  line-height: 1.6;
  flex: 1;
}

/* ========== 联系我们 ========== */
.contact-card {
  padding: 8rpx 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 22rpx;
  color: var(--dm-muted);
  display: block;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 26rpx;
  color: var(--dm-text);
}

.contact-action {
  font-size: 24rpx;
  color: var(--dm-primary);
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--dm-primary);
  border-radius: 20rpx;
}

.contact-action:active {
  background: #e8f5ee;
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: 60rpx;
}