/* pages/team/team.wxss — 团队管理 渔乡文艺风 */

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--dm-border);
  border-top-color: var(--dm-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 36rpx;
  height: 36rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--dm-muted);
}

/* ========== 无团队空状态 ========== */
.empty-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eaf5f2, transparent);
  margin: 0 24rpx;
  border-radius: var(--dm-radius);
}

.empty-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60rpx;
}

.ew-1 {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 200%;
  height: 100%;
  background: rgba(61, 142, 122, 0.06);
  border-radius: 50% 50% 0 0;
  animation: ewf1 6s ease-in-out infinite;
}

.ew-2 {
  position: absolute;
  bottom: 15rpx;
  left: 0;
  width: 200%;
  height: 100%;
  background: rgba(61, 142, 122, 0.04);
  border-radius: 45% 55% 0 0;
  animation: ewf2 8s ease-in-out infinite;
}

@keyframes ewf1 {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-30rpx); }
}

@keyframes ewf2 {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(30rpx); }
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  z-index: 1;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--dm-text);
  margin-bottom: 8rpx;
  z-index: 1;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--dm-muted);
  z-index: 1;
}

/* ========== 操作卡片（创建/搜索） ========== */
.action-card {
  background: var(--dm-card);
  margin: 20rpx 24rpx;
  border-radius: var(--dm-radius);
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.action-header {
  display: flex;
  align-items: center;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 300;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.create-icon {
  background: rgba(61, 142, 122, 0.1);
  color: var(--dm-primary);
}

.join-icon {
  background: rgba(232, 168, 64, 0.1);
  font-size: 32rpx;
}

.action-info {
  flex: 1;
}

.action-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--dm-text);
  margin-bottom: 4rpx;
}

.action-desc {
  display: block;
  font-size: 24rpx;
  color: var(--dm-muted);
}

.action-arrow {
  font-size: 32rpx;
  color: var(--dm-muted);
  transition: transform 0.3s;
  flex-shrink: 0;
}

.action-arrow.arrow-up {
  transform: rotate(90deg);
}

/* ========== 创建表单 ========== */
.create-form {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--dm-border);
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--dm-text);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--dm-bg);
  border-radius: var(--dm-radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--dm-bg);
  border-radius: var(--dm-radius-sm);
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ========== 搜索区域 ========== */
.search-box {
  display: flex;
  margin-top: 20rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--dm-bg);
  border-radius: var(--dm-radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
}

.btn-search {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--dm-primary);
  color: #fff;
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.btn-search:active {
  background: var(--dm-primary-dark);
}

/* 搜索结果 */
.search-results {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--dm-muted);
  gap: 12rpx;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.result-item:last-child {
  border-bottom: none;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--dm-text);
}

.result-intro {
  display: block;
  font-size: 24rpx;
  color: var(--dm-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  display: block;
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-top: 4rpx;
}

.btn-join {
  padding: 12rpx 28rpx;
  background: var(--dm-primary);
  color: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ========== 团队信息卡片 ========== */
.team-card {
  background: var(--dm-card);
  margin: 20rpx 24rpx;
  border-radius: var(--dm-radius);
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.team-card-header {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #eaf5f2, #f0f8f5);
}

.team-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--dm-primary), var(--dm-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.team-avatar text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.team-card-info {
  flex: 1;
  min-width: 0;
}

.team-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.team-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--dm-text);
}

.team-role-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 10rpx;
  background: var(--dm-primary);
  color: #fff;
  flex-shrink: 0;
}

.team-role-badge.vice {
  background: var(--dm-accent);
}

.team-intro {
  display: block;
  font-size: 24rpx;
  color: var(--dm-muted);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-member-count {
  font-size: 24rpx;
  color: var(--dm-muted);
}

/* ========== 预约统计 ========== */
.team-stats {
  padding: 0 28rpx 24rpx;
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 12rpx;
}

.stats-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--dm-text);
}

.stats-arrow {
  font-size: 28rpx;
  color: var(--dm-muted);
  transition: transform 0.3s;
}

.stats-arrow.arrow-up {
  transform: rotate(90deg);
}

.stats-summary {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--dm-primary);
  line-height: 1.1;
}

.stat-num.stat-warn {
  color: #d4644a;
}

.stat-desc {
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-top: 4rpx;
}

.stat-max {
  font-size: 20rpx;
  color: #c0b5a5;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--dm-border);
}

.stats-detail {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(61, 142, 122, 0.04);
  border-radius: var(--dm-radius-sm);
}

.sd-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.sd-label {
  font-size: 24rpx;
  color: var(--dm-muted);
}

.sd-value {
  font-size: 24rpx;
  color: var(--dm-text);
  font-weight: 500;
}

/* ========== 分区卡片 ========== */
.section-card {
  background: var(--dm-card);
  margin: 0 24rpx 20rpx;
  border-radius: var(--dm-radius);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--dm-text);
}

.section-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--dm-muted);
}

.section-arrow {
  font-size: 28rpx;
  color: var(--dm-muted);
  transition: transform 0.3s;
}

.section-arrow.arrow-up {
  transform: rotate(90deg);
}

/* ========== 成员列表 ========== */
.member-list {
  padding: 0 28rpx 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c5e0d6, #b8d9ce);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.member-avatar text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--dm-primary-dark);
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
}

.member-name {
  font-size: 28rpx;
  color: var(--dm-text);
}

.member-role {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.member-role.leader {
  background: rgba(61, 142, 122, 0.12);
  color: var(--dm-primary);
}

.member-role.vice {
  background: rgba(232, 168, 64, 0.12);
  color: var(--dm-accent);
}

.member-phone {
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-top: 2rpx;
}

/* ========== 操作列表 ========== */
.action-list {
  padding: 0 28rpx 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.action-item:last-child {
  border-bottom: none;
}

.ai-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ai-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--dm-text);
}

.ai-hint {
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-right: 8rpx;
}

.ai-arrow {
  font-size: 28rpx;
  color: var(--dm-muted);
}

.action-danger .ai-text,
.danger-text {
  color: #d4644a;
}

/* ========== 全局按钮 ========== */
.btn-primary {
  background: var(--dm-primary);
  color: #fff;
  border-radius: var(--dm-radius-sm);
  padding: 20rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin-top: 8rpx;
}

.btn-primary:active {
  background: var(--dm-primary-dark);
}

.btn-loading {
  opacity: 0.7;
  pointer-events: none;
}

/* ========== 弹窗通用 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fadeIn 0.2s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 600rpx;
  max-height: 70vh;
  background: var(--dm-card);
  border-radius: var(--dm-radius);
  padding: 40rpx 32rpx;
  animation: slideUp 0.3s ease-out;
  display: flex;
  flex-direction: column;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--dm-text);
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: var(--dm-muted);
  text-align: center;
  margin-bottom: 24rpx;
}

.danger-desc {
  color: #d4644a;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid var(--dm-border);
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: var(--dm-muted);
}

.btn-submit {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: var(--dm-primary);
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.btn-submit:active {
  background: var(--dm-primary-dark);
}

.btn-danger {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: #d4644a;
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.btn-danger:active {
  background: #c0523a;
}

/* ========== 副队长选择列表 ========== */
.vice-list {
  max-height: 400rpx;
  margin-bottom: 8rpx;
}

.vice-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.vice-item:last-child {
  border-bottom: none;
}

.vice-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c5e0d6, #b8d9ce);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.vice-avatar text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--dm-primary-dark);
}

.vice-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--dm-text);
}

.vice-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--dm-primary);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vice-item.vice-selected {
  background: rgba(61, 142, 122, 0.04);
  border-radius: var(--dm-radius-sm);
}
/* ========== 未登录提示 ========== */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.login-prompt-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.login-prompt-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--dm-text);
  margin-bottom: 12rpx;
}

.login-prompt-desc {
  font-size: 26rpx;
  color: var(--dm-muted);
  margin-bottom: 40rpx;
}

.login-prompt-btn {
  padding: 20rpx 80rpx;
  background: var(--dm-primary);
  color: #fff;
  border-radius: var(--dm-radius-sm);
  font-size: 30rpx;
  font-weight: 600;
}

.login-prompt-btn:active {
  background: var(--dm-primary-dark);
}
