/* pages/team/team.wxss — 团队管理 渔乡文艺风 */

.page-team {
  min-height: 100vh;
  background: #faf8f6;
  padding-bottom: 40rpx;
}

/* pages/team/team.wxss — 团队管理 渔乡文艺风 */

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--dm-border);
  border-top-color: var(--dm-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 36rpx;
  height: 36rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--dm-muted);
}

/* ========== 无团队状态 ========== */
.no-team {
  padding: 0 48rpx;
}

.no-team-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eaf5f2, transparent);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

/* 波浪装饰 */
.no-team-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
}

.ntw-layer {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 200%;
  height: 100%;
}

.ntw-1 {
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 50rpx,
    rgba(61, 142, 122, 0.08) 50rpx,
    rgba(61, 142, 122, 0.08) 52rpx
  );
  border-radius: 50% 50% 0 0;
  animation: ntwFloat1 6s ease-in-out infinite;
}

.ntw-2 {
  bottom: 20rpx;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 70rpx,
    rgba(61, 142, 122, 0.05) 70rpx,
    rgba(61, 142, 122, 0.05) 72rpx
  );
  border-radius: 45% 55% 0 0;
  animation: ntwFloat2 8s ease-in-out infinite reverse;
}

.ntw-3 {
  bottom: 40rpx;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 90rpx,
    rgba(61, 142, 122, 0.03) 90rpx,
    rgba(61, 142, 122, 0.03) 92rpx
  );
  border-radius: 40% 60% 0 0;
  animation: ntwFloat3 10s ease-in-out infinite;
}

@keyframes ntwFloat1 {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-40rpx); }
}

@keyframes ntwFloat2 {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(40rpx); }
}

@keyframes ntwFloat3 {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-25rpx); }
}

.no-team-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.no-team-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--dm-text);
  margin-bottom: 12rpx;
}

.no-team-desc {
  font-size: 26rpx;
  color: var(--dm-muted);
  text-align: center;
  line-height: 1.5;
}

/* 两个胶囊操作按钮 */
.no-team-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.no-team-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: opacity 0.15s;
}

.no-team-btn:active {
  opacity: 0.8;
}

.ntb-icon {
  font-size: 36rpx;
  font-weight: 400;
}

.no-team-btn-create {
  background: linear-gradient(135deg, #3d8e7a, #2e6e5e);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(61, 142, 122, 0.3);
}

.no-team-btn-join {
  background: #fff;
  color: #3d8e7a;
  border: 2rpx solid #3d8e7a;
}

/* ========== 底部弹窗 Sheet ========== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.sheet-mask-show {
  opacity: 1;
  visibility: visible;
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.sheet-panel-show {
  transform: translateY(0);
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
  flex-shrink: 0;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx 16rpx;
  position: relative;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #211c18;
}

.sheet-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #8c7b6a;
  padding: 8rpx;
}

.sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
  -webkit-overflow-scrolling: touch;
}

.sheet-footer {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 表单（在 sheet 内复用） */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #211c18;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #faf8f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #faf8f6;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 搜索框（在 sheet 内） */
.search-box {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #faf8f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-search {
  padding: 0 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #3d8e7a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
  text-align: center;
}

.btn-search:active {
  background: #2e6e5e;
}

.search-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #8c7b6a;
}

.no-result-text {
  font-size: 26rpx;
  color: #8c7b6a;
}

/* 搜索结果列表 */
.search-results {
  padding: 8rpx 0 24rpx;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ebe3da;
}

.result-item:last-child {
  border-bottom: none;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #211c18;
}

.result-intro {
  display: block;
  font-size: 24rpx;
  color: #8c7b6a;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  display: block;
  font-size: 22rpx;
  color: #8c7b6a;
  margin-top: 4rpx;
}

.btn-join {
  padding: 14rpx 32rpx;
  background: #3d8e7a;
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.btn-join.btn-loading {
  opacity: 0.6;
  pointer-events: none;
}

/* 全部团队列表 */
.all-teams-section {
  padding: 8rpx 0 24rpx;
}

.all-teams-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #8c7b6a;
  padding: 16rpx 0 12rpx;
}

/* sheet 内按钮 */
.sheet-footer .no-team-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.sheet-footer .no-team-btn-create {
  background: linear-gradient(135deg, #3d8e7a, #2e6e5e);
  color: #fff;
}

.btn-loading {
  opacity: 0.6;
  pointer-events: none;
}

/* ========== 团队信息卡片 ========== */
.team-card {
  background: var(--dm-card);
  margin: 20rpx 24rpx;
  border-radius: var(--dm-radius);
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.team-card-header {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #eaf5f2, #f0f8f5);
}

.team-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--dm-primary), var(--dm-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.team-avatar text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.team-card-info {
  flex: 1;
  min-width: 0;
}

.team-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.team-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--dm-text);
}

.team-role-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 10rpx;
  background: var(--dm-primary);
  color: #fff;
  flex-shrink: 0;
}

.team-role-badge.vice {
  background: var(--dm-accent);
}

.team-intro {
  display: block;
  font-size: 24rpx;
  color: var(--dm-muted);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-member-count {
  font-size: 24rpx;
  color: var(--dm-muted);
}

/* ========== 预约统计 ========== */
.team-stats {
  padding: 0 28rpx 24rpx;
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 12rpx;
}

.stats-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--dm-text);
}

.stats-arrow {
  font-size: 28rpx;
  color: var(--dm-muted);
  transition: transform 0.3s;
}

.stats-arrow.arrow-up {
  transform: rotate(90deg);
}

.stats-summary {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--dm-primary);
  line-height: 1.1;
}

.stat-num.stat-warn {
  color: #d4644a;
}

.stat-desc {
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-top: 4rpx;
}

.stat-max {
  font-size: 20rpx;
  color: #c0b5a5;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--dm-border);
}

.stats-detail {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(61, 142, 122, 0.04);
  border-radius: var(--dm-radius-sm);
}

.sd-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.sd-label {
  font-size: 24rpx;
  color: var(--dm-muted);
}

.sd-value {
  font-size: 24rpx;
  color: var(--dm-text);
  font-weight: 500;
}

/* ========== 分区卡片 ========== */
.section-card {
  background: var(--dm-card);
  margin: 0 24rpx 20rpx;
  border-radius: var(--dm-radius);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--dm-text);
}

.section-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--dm-muted);
}

.section-arrow {
  font-size: 28rpx;
  color: var(--dm-muted);
  transition: transform 0.3s;
}

.section-arrow.arrow-up {
  transform: rotate(90deg);
}

/* ========== 成员列表 ========== */
.member-list {
  padding: 0 28rpx 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c5e0d6, #b8d9ce);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.member-avatar text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--dm-primary-dark);
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
}

.member-name {
  font-size: 28rpx;
  color: var(--dm-text);
}

.member-role {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.member-role.leader {
  background: rgba(61, 142, 122, 0.12);
  color: var(--dm-primary);
}

.member-role.vice {
  background: rgba(232, 168, 64, 0.12);
  color: var(--dm-accent);
}

.member-phone {
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-top: 2rpx;
}

/* ========== 操作列表 ========== */
.action-list {
  padding: 0 28rpx 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.action-item:last-child {
  border-bottom: none;
}

.ai-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ai-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--dm-text);
}

.ai-hint {
  font-size: 22rpx;
  color: var(--dm-muted);
  margin-right: 8rpx;
}

.ai-arrow {
  font-size: 28rpx;
  color: var(--dm-muted);
}

.action-danger .ai-text,
.danger-text {
  color: #d4644a;
}

/* ========== 全局按钮 ========== */
.btn-primary {
  background: var(--dm-primary);
  color: #fff;
  border-radius: var(--dm-radius-sm);
  padding: 20rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  margin-top: 8rpx;
}

.btn-primary:active {
  background: var(--dm-primary-dark);
}

.btn-loading {
  opacity: 0.7;
  pointer-events: none;
}

/* ========== 弹窗通用 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fadeIn 0.2s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 600rpx;
  max-height: 70vh;
  background: var(--dm-card);
  border-radius: var(--dm-radius);
  padding: 40rpx 32rpx;
  animation: slideUp 0.3s ease-out;
  display: flex;
  flex-direction: column;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--dm-text);
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: var(--dm-muted);
  text-align: center;
  margin-bottom: 24rpx;
}

.danger-desc {
  color: #d4644a;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid var(--dm-border);
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: var(--dm-muted);
}

.btn-submit {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: var(--dm-primary);
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.btn-submit:active {
  background: var(--dm-primary-dark);
}

.btn-danger {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: #d4644a;
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.btn-danger:active {
  background: #c0523a;
}

/* ========== 副队长选择列表 ========== */
.vice-list {
  max-height: 400rpx;
  margin-bottom: 8rpx;
}

.vice-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--dm-border);
}

.vice-item:last-child {
  border-bottom: none;
}

.vice-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c5e0d6, #b8d9ce);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.vice-avatar text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--dm-primary-dark);
}

.vice-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--dm-text);
}

.vice-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--dm-primary);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vice-item.vice-selected {
  background: rgba(61, 142, 122, 0.04);
  border-radius: var(--dm-radius-sm);
}
/* ========== 未登录提示 ========== */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.login-prompt-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.login-prompt-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--dm-text);
  margin-bottom: 12rpx;
}

.login-prompt-desc {
  font-size: 26rpx;
  color: var(--dm-muted);
  margin-bottom: 40rpx;
}

.login-prompt-btn {
  padding: 20rpx 80rpx;
  background: var(--dm-primary);
  color: #fff;
  border-radius: var(--dm-radius-sm);
  font-size: 30rpx;
  font-weight: 600;
}

.login-prompt-btn:active {
  background: var(--dm-primary-dark);
}
