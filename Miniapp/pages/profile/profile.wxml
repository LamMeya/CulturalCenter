<!-- pages/profile/profile.wxml — 我的个人中心 -->
<view class="page-container">

  <!-- ==================== 未登录状态 ==================== -->
  <view wx:if="{{!isLoggedIn}}" class="auth-page">
    <!-- Logo 标题区 -->
    <view class="auth-header">
      <view class="auth-logo">
        <text class="auth-logo-icon">🏛️</text>
      </view>
      <text class="auth-title">珠海文化中心</text>
      <text class="auth-subtitle">场地预约平台</text>
    </view>

    <!-- 登录/注册 Tab 切换 -->
    <view class="auth-tabs">
      <view
        class="auth-tab {{authMode === 'login' ? 'auth-tab-active' : ''}}"
        data-mode="login"
        bindtap="onSwitchAuthMode"
      >
        <text>账号登录</text>
      </view>
      <view
        class="auth-tab {{authMode === 'register' ? 'auth-tab-active' : ''}}"
        data-mode="register"
        bindtap="onSwitchAuthMode"
      >
        <text>手机号注册</text>
      </view>
    </view>

    <!-- ===== 登录表单 ===== -->
    <view class="auth-form" wx:if="{{authMode === 'login'}}">
      <view class="form-group">
        <view class="form-icon">👤</view>
        <input
          class="form-input"
          placeholder="请输入账号"
          value="{{username}}"
          data-field="username"
          bindinput="onInputField"
          maxlength="30"
        />
      </view>
      <view class="form-group">
        <view class="form-icon">🔒</view>
        <input
          class="form-input"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          data-field="password"
          bindinput="onInputField"
          maxlength="30"
        />
      </view>
      <view
        class="btn-primary auth-btn {{!username || !password ? 'btn-disabled' : ''}}"
        bindtap="onPhoneLogin"
      >
        <text>{{authLoading ? '登录中...' : '登录'}}</text>
      </view>
    </view>

    <!-- ===== 注册表单 ===== -->
    <view class="auth-form" wx:if="{{authMode === 'register'}}">
      <view class="form-group">
        <view class="form-icon">👤</view>
        <input
          class="form-input"
          placeholder="账号（用于登录）"
          value="{{username}}"
          data-field="username"
          bindinput="onInputField"
          maxlength="30"
        />
      </view>
      <view class="form-group">
        <view class="form-icon">😊</view>
        <input
          class="form-input"
          placeholder="昵称"
          value="{{nickname}}"
          data-field="nickname"
          bindinput="onInputField"
          maxlength="20"
        />
      </view>
      <view class="form-group">
        <view class="form-icon">📱</view>
        <input
          class="form-input"
          type="number"
          placeholder="手机号"
          value="{{phone}}"
          data-field="phone"
          bindinput="onInputField"
          maxlength="11"
        />
      </view>
      <view class="form-group">
        <view class="form-icon">🔒</view>
        <input
          class="form-input"
          type="password"
          placeholder="设置密码（至少4位）"
          value="{{password}}"
          data-field="password"
          bindinput="onInputField"
          maxlength="30"
        />
      </view>
      <view class="form-group">
        <view class="form-icon">🔒</view>
        <input
          class="form-input"
          type="password"
          placeholder="确认密码"
          value="{{confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInputField"
          maxlength="30"
        />
      </view>
      <view
        class="btn-primary auth-btn {{!username || !password || !confirmPassword || !phone ? 'btn-disabled' : ''}}"
        bindtap="onPhoneRegister"
      >
        <text>{{authLoading ? '注册中...' : '注册'}}</text>
      </view>
    </view>

    <!-- 分隔线 -->
    <view class="auth-divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <!-- 微信登录按钮 -->
    <view class="wx-login-btn" bindtap="onWxLogin">
      <text class="wx-login-icon">💬</text>
      <text>微信登录</text>
    </view>

    <!-- 协议提示 -->
    <text class="auth-agreement">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>

  <!-- ==================== 已登录状态 ==================== -->
  <view wx:else>
    <view class="user-card card">
      <view class="user-info">
        <view class="avatar-wrap">
          <image
            wx:if="{{userInfo.avatar}}"
            class="avatar-img"
            src="{{userInfo.avatar}}"
            mode="aspectFill"
          />
          <view wx:else class="avatar-placeholder">
            <text>👤</text>
          </view>
        </view>
        <view class="user-detail">
          <text class="user-nickname">{{userInfo.nickname || '用户'}}</text>
          <text class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
          <view wx:else class="bind-phone-btn" bindtap="onGetPhoneNumber">
            <text>绑定手机号</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{teamInfo}}" class="team-card card">
      <view class="team-header">
        <text class="team-label">我的团队</text>
        <view class="team-role-badge">
          <text>{{teamInfo.role === 'leader' ? '队长' : '成员'}}</text>
        </view>
      </view>
      <text class="team-name">{{teamInfo.team_name}}</text>
    </view>

    <view class="actions-section">
      <view class="section-title">快捷操作</view>
      <view class="action-list">
        <view class="action-item" bindtap="onGoToTeam">
          <view class="action-left">
            <text class="action-icon">👥</text>
            <text class="action-text">我的团队</text>
          </view>
          <text class="action-arrow">›</text>
        </view>
        <view class="action-item" bindtap="onGoToBookings">
          <view class="action-left">
            <text class="action-icon">📅</text>
            <text class="action-text">预约记录</text>
          </view>
          <text class="action-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="logout-section">
      <view class="btn-logout" bindtap="onLogout">
        <text>退出登录</text>
      </view>
    </view>
  </view>
</view>
