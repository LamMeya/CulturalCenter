/* pages/profile/profile.wxss — 我的个人中心 */

.page-container {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ========== 未登录 — 认证页 ========== */
.auth-page {
  padding: 0 48rpx;
}

/* Logo 标题区 */
.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: 48rpx;
}

.auth-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--dm-primary), var(--dm-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(61, 142, 122, 0.25);
}

.auth-logo-icon {
  font-size: 56rpx;
}

.auth-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--dm-text);
  margin-bottom: 8rpx;
}

.auth-subtitle {
  font-size: 26rpx;
  color: var(--dm-muted);
}

/* 登录/注册 Tab */
.auth-tabs {
  display: flex;
  background: var(--dm-border);
  border-radius: var(--dm-radius-sm);
  padding: 6rpx;
  margin-bottom: 32rpx;
}

.auth-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--dm-muted);
  border-radius: var(--dm-radius-sm);
  transition: all 0.2s;
}

.auth-tab-active {
  background: #fff;
  color: var(--dm-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 表单 */
.auth-form {
  margin-bottom: 32rpx;
}

.form-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--dm-radius-sm);
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.form-icon {
  width: 48rpx;
  font-size: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--dm-text);
  padding-left: 12rpx;
}

.auth-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--dm-radius-sm);
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.btn-disabled {
  background: var(--dm-border) !important;
  color: var(--dm-muted) !important;
}

/* 分隔线 */
.auth-divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--dm-border);
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--dm-muted);
}

/* 微信登录按钮 */
.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid var(--dm-border);
  border-radius: var(--dm-radius-sm);
  font-size: 28rpx;
  color: var(--dm-text);
  margin-bottom: 24rpx;
}

.wx-login-btn:active {
  background: #f5f5f5;
}

.wx-login-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 协议提示 */
.auth-agreement {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--dm-muted);
  padding-bottom: 60rpx;
}

/* ========== 用户信息卡片 ========== */
.user-card {
  margin-top: 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: var(--dm-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.user-detail {
  flex: 1;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--dm-text);
  display: block;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: var(--dm-muted);
}

.bind-phone-btn {
  display: inline-block;
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--dm-primary);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--dm-primary);
}

/* ========== 团队信息卡片 ========== */
.team-card {
  margin-top: 16rpx;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.team-label {
  font-size: 26rpx;
  color: var(--dm-muted);
}

.team-role-badge {
  padding: 4rpx 16rpx;
  background: #e8f5ee;
  color: var(--dm-primary);
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.team-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--dm-text);
}

/* ========== 快捷操作 ========== */
.actions-section {
  margin-top: 32rpx;
}

.actions-section .section-title {
  font-size: 26rpx;
  color: var(--dm-muted);
  margin: 0 24rpx 16rpx;
}

.action-list {
  background: var(--dm-card);
  margin: 0 24rpx;
  border-radius: var(--dm-radius);
  overflow: hidden;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--dm-border);
}

.action-item:last-child {
  border-bottom: none;
}

.action-left {
  display: flex;
  align-items: center;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.action-text {
  font-size: 28rpx;
  color: var(--dm-text);
}

.action-arrow {
  font-size: 36rpx;
  color: var(--dm-border);
  font-weight: 300;
}

.action-item:active {
  background: #faf8f6;
}

/* ========== 退出登录 ========== */
.logout-section {
  padding: 64rpx 24rpx 40rpx;
}

.btn-logout {
  text-align: center;
  padding: 24rpx;
  border-radius: var(--dm-radius-sm);
  border: 2rpx solid var(--dm-border);
  font-size: 28rpx;
  color: var(--dm-muted);
}

.btn-logout:active {
  background: #faf8f6;
}
