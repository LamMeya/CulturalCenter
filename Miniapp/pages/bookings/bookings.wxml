<!-- pages/bookings/bookings.wxml — 我的预约 -->
<view class="page-container">

  <!-- 未登录提示 -->
  <view wx:if="{{!isLoggedIn}}" class="login-prompt">
    <view class="login-prompt-icon">🔒</view>
    <text class="login-prompt-title">查看预约需要登录</text>
    <text class="login-prompt-desc">登录后可查看和管理您的场馆预约</text>
    <view class="login-prompt-btn" bindtap="onGoToLogin">去登录</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{isLoggedIn && loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isLoggedIn && empty && !loading}}" class="empty-wrap">
    <view class="empty-illustration">
      <view class="empty-icon">📋</view>
    </view>
    <text class="empty-title">暂无预约记录</text>
    <text class="empty-desc">去首页看看可预约的场地吧</text>
  </view>

  <!-- 预约列表 -->
  <view wx:elif="{{isLoggedIn}}" class="bookings-list">
    <view
      wx:for="{{bookings}}"
      wx:key="id"
      class="booking-card card"
    >
      <view class="booking-header">
        <text class="venue-name">{{item.venue_name}}</text>
        <view class="status-badge badge-{{item.status}}">
          <text>{{item.statusText}}</text>
        </view>
      </view>

      <view class="booking-info">
        <view class="info-row">
          <text class="info-label">日期</text>
          <text class="info-value">{{item.date}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">时间</text>
          <text class="info-value">{{item.time_slot_start}} - {{item.time_slot_end}}</text>
        </view>
        <view class="info-row" wx:if="{{item.team_name}}">
          <text class="info-label">团队</text>
          <text class="info-value">{{item.team_name}}</text>
        </view>
      </view>

      <view wx:if="{{item.status === 'pending' || item.status === 'won'}}" class="booking-actions">
        <view
          class="btn-cancel"
          data-id="{{item.id}}"
          bindtap="onCancelTap"
        >
          取消预约
        </view>
      </view>
    </view>
  </view>

  <!-- 取消确认弹窗 -->
  <view wx:if="{{showCancelModal}}" class="modal-mask" bindtap="onCancelModalClose">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">确认取消</text>
      </view>
      <view class="modal-body">
        <text class="modal-text">确定要取消该预约吗？</text>
        <text class="modal-hint">取消后不可恢复</text>
      </view>
      <view class="modal-footer">
        <view class="modal-btn modal-btn-cancel" bindtap="onCancelModalClose">
          <text>再想想</text>
        </view>
        <view class="modal-btn modal-btn-confirm {{cancelLoading ? 'disabled' : ''}}" bindtap="onConfirmCancel">
          <text>{{cancelLoading ? '取消中...' : '确认取消'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
